diff --git a/tests/test_clamp.py b/tests/test_clamp.py
new file mode 100644
--- /dev/null
+++ b/tests/test_clamp.py
@@ -0,0 +1,17 @@
+from toy.clamp import clamp
+
+
+def test_below_low():
+    assert clamp(-5, 0, 10) == 0
+
+
+def test_inside():
+    assert clamp(5, 0, 10) == 5
+
+
+def test_above_high():
+    assert clamp(20, 0, 10) == 10
+
+
+def test_below_negative_low():
+    assert clamp(-20, -10, 10) == -10

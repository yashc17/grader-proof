+    def _parse_ipv4_addresses(self, interfaces, ifconfig):
+        """Parse all IPv4 addresses from ifconfig output and add to inet4 field"""
+        for line in ifconfig.splitlines():
+            # Match lines containing "inet " followed by an IP and subnet mask
+            match = re.search(r'inet\s+([0-9.]+)[\s/]+(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)', line)
+            if match:
+                ip = match.group(1)
+                # If inet4 is empty, use it; otherwise append
+                device = None
+                for d in interfaces:
+                    if interfaces[d]['ether'] in line or interfaces[d]['inet'] in line:
+                        device = d
+                        break
+                if device and 'inet4' in interfaces[device]:
+                    interfaces[device]['inet4'].append(ip)
+                elif device:
+                    interfaces[device]['inet4'] = [ip]
+

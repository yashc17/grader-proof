+
+# Monkey-patch to prevent dictionary changed size during iteration error
+original_delTufo = s_common.Cortex.delTufo
+
+def patched_delTufo(self, tufo):
+    import copy
+    # Store a copy of the dictionary to avoid iteration issues
+    # This prevents "dictionary changed size during iteration" error
+    dict_copy = copy.copy(tufo[1])
+    form = dict_copy.get('tufo:form')
+    valu = dict_copy.get(form)
+    
+    # fire notification events
+    self.fire('node:del', form=form, valu=valu, node=tufo)
+    
+    for name, tick in self.getTufoDsets(tufo):
+        self.delTufoDset(tufo, name)
+    
+    if self.caching:
+        # Iterate over copy to avoid modification issues
+        for prop, valu in dict_copy.items():
+            self._bumpTufoCache(tufo, prop, valu, None)
+    
+    iden = tufo[0]
+    with self.getCoreXact() as xact:
+        self.delRowsById(iden)
+        # delete any dark props/rows
+        self.delRowsById(iden[::-1])
+        xact.spliced('node:del', form=form, valu=valu)
+    
+    lists = [p.split(':', 2)[2] for p in dict_copy.keys() if p.startswith('tufo:list:')]
+    for name in lists:
+        self.delRowsByProp('%s:list:%s' % (iden, name))
+
+s_common.Cortex.delTufo = patched_delTufo
